function runAgent(id,btn){
  const a=AGENTS.find(x=>x.id===id);if(!a)return;
  btn.disabled=true;btn.textContent='Running…';a.status='running';
  const card=document.getElementById('agent-'+id);
  if(card){const b=card.querySelector('.badge');if(b){b.className='badge running';b.innerHTML='<div class="badge-dot"></div>RUNNING';}}
  setTimeout(()=>{
    a.status='idle';a.runs++;a.lastRun='just now';
    btn.disabled=false;btn.innerHTML='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="11" height="11"><polygon points="5 3 19 12 5 21 5 3"/></svg> Execute';
