    ${dir!=='neutral'?`<div class="kpi-delta ${dir}">${dir==='up'?'↑':'↓'} ${Math.abs(delta)}%</div>`:''}
    ${sparkData?`<div class="sparkline ${color}" style="position:absolute;bottom:0;right:0;height:36px;width:70px;opacity:.18;align-items:flex-end;">${bars}</div>`:''}
  </div>`;
}
