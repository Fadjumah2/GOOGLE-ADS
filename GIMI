function quickSend(msg){const i=document.getElementById('chat-input');if(i){i.value=msg;sendChat()}}
function sendChat(){
  const inp=document.getElementById('chat-input'),msgs=document.getElementById('chat-msgs');
  if(!inp||!msgs||!inp.value.trim())return;
  const msg=inp.value.trim();inp.value='';inp.style.height='auto';
  const now=new Date().toTimeString().slice(0,5);
  const ud=document.createElement('div');ud.className='msg user';ud.style.cssText='max-width:88%;align-self:flex-end';
  ud.innerHTML=`<div class="msg-avatar user">U</div><div><div class="msg-bubble">${msg}</div><div class="msg-time">${now}</div></div>`;
  msgs.appendChild(ud);
  const typing=document.createElement('div');typing.className='msg ai';typing.style.maxWidth='88%';
  typing.innerHTML=`<div class="msg-avatar ai">AI</div><div><div class="msg-bubble" style="color:var(--text3)">Analyzing…</div></div>`;
  msgs.appendChild(typing);msgs.scrollTop=msgs.scrollHeight;
  const responses={
    roas:`Based on current data: <b>Retargeting_Pro (4.8x)</b> leads, then Brand_Search_US (3.2x) and Shopping_General (2.9x). Display_Awareness is below your 2.0x floor at 1.4x — I'd recommend pausing or adjusting bids.`,
    campaign:`You have ${CAMPAIGNS.length} campaigns: ${CAMPAIGNS.filter(c=>c.status==='active').length} active, ${CAMPAIGNS.filter(c=>c.status==='paused').length} paused. Total spend: $${fmt2(CAMPAIGNS.reduce((s,c)=>s+c.cost,0))}.`,
    run:`Executing ROI Sentry now. Results will appear in Workflows within 30 seconds.`,
    approve:`I've approved all ${WORKFLOWS.filter(w=>w.status==='pending').length} pending workflow actions. They'll execute in the next agent cycle.`,
    weekly:`Weekly summary: ${fmt(CAMPAIGNS.reduce((s,c)=>s+c.clicks,0))} clicks (+14.2%), $${fmt2(CAMPAIGNS.reduce((s,c)=>s+c.cost,0))} spend (+5.7%), ${CAMPAIGNS.reduce((s,c)=>s+c.conv,0)} conversions (+9.1%). Avg ROAS 2.8x. Top: Retargeting_Pro.`,
  };
  setTimeout(()=>{
    typing.remove();
    const key=Object.keys(responses).find(k=>msg.toLowerCase().includes(k));
    const reply=key?responses[key]:`I've analyzed "<em>${msg}</em>". I recommend focusing on <b>Retargeting_Pro</b> (4.8x ROAS) and reviewing <b>Display_Awareness</b> (1.4x, below floor). Would you like me to trigger an agent?`;
    const ad=document.createElement('div');ad.className='msg ai';ad.style.maxWidth='88%';
    ad.innerHTML=`<div class="msg-avatar ai">AI</div><div><div class="msg-bubble">${reply}</div><div class="msg-time">${new Date().toTimeString().slice(0,5)}</div></div>`;
    msgs.appendChild(ad);msgs.scrollTop=msgs.scrollHeight;
  },1200);
}

