<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Synapse · AI Ops Console</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
:root {
  --bg:#030608;--bg2:#080d12;--bg3:#0d1520;
  --surface:#0f1923;--surface2:#162130;
  --border:#1e2d3d;--border2:#243444;
  --cyan:#00d4ff;--cyan-dim:rgba(0,212,255,.12);
  --green:#00e5a0;--green-dim:rgba(0,229,160,.12);
  --red:#ff4d6d;--red-dim:rgba(255,77,109,.12);
  --amber:#ffb547;--amber-dim:rgba(255,181,71,.12);
  --purple:#a78bfa;--purple-dim:rgba(167,139,250,.12);
  --text:#e8f0fe;--text2:#8ba3bf;--text3:#4d6478;
  --mono:'JetBrains Mono',monospace;--sans:'Space Grotesk',sans-serif;
  --sidebar-w:264px;--hdr:56px;--r:10px;--r-sm:6px;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;background:var(--bg);color:var(--text);font-family:var(--sans);font-size:14px;-webkit-font-smoothing:antialiased;overflow:hidden}
::-webkit-scrollbar{width:4px;height:4px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:4px}
::-webkit-scrollbar-thumb:hover{background:var(--cyan)}

/* ── LAYOUT ── */
#shell{display:flex;height:100vh;position:relative;overflow:hidden}

/* ── BACKDROP ── */
#sidebar-backdrop{
  position:fixed;inset:0;z-index:98;
  background:rgba(3,6,8,.65);backdrop-filter:blur(4px);
  opacity:0;visibility:hidden;
  transition:opacity .28s,visibility .28s;
}
#sidebar-backdrop.visible{opacity:1;visibility:visible}

/* ── SIDEBAR — always a floating overlay ── */
#sidebar{
  position:fixed;left:0;top:0;bottom:0;
  width:var(--sidebar-w);z-index:99;
  background:var(--bg2);border-right:1px solid var(--border);
  display:flex;flex-direction:column;
  transform:translateX(-100%);visibility:hidden;
  transition:transform .28s cubic-bezier(.4,0,.2,1),visibility .28s;
  overflow:hidden;
}
#sidebar.open{transform:translateX(0);visibility:visible}
#sidebar::before{
  content:'';position:absolute;top:-100px;left:-60px;
  width:300px;height:300px;
  background:radial-gradient(circle,rgba(0,212,255,.06) 0%,transparent 70%);
  pointer-events:none;
}

.logo-wrap{
  padding:16px 18px 14px;border-bottom:1px solid var(--border);
  display:flex;align-items:center;gap:10px;
}
.logo-icon{
  width:32px;height:32px;flex-shrink:0;border-radius:8px;
  background:linear-gradient(135deg,var(--cyan),#0086cc);
  display:flex;align-items:center;justify-content:center;
}
.logo-icon svg{width:18px;height:18px}
.logo-text{font-size:15px;font-weight:700;letter-spacing:-.02em}
.logo-badge{
  margin-left:auto;font-size:9px;font-weight:600;
  background:var(--cyan-dim);color:var(--cyan);
  border:1px solid rgba(0,212,255,.25);padding:2px 6px;border-radius:4px;
}
.sidebar-close{
  margin-left:6px;width:26px;height:26px;border-radius:5px;flex-shrink:0;
  background:none;border:1px solid var(--border);color:var(--text3);cursor:pointer;
  display:flex;align-items:center;justify-content:center;transition:all .18s;
}
.sidebar-close:hover{border-color:var(--red);color:var(--red)}
.sidebar-close svg{width:13px;height:13px}

.mode-strip{
  margin:10px 14px;background:var(--surface);border:1px solid var(--border);
  border-radius:var(--r-sm);display:flex;align-items:center;padding:4px;gap:4px;
}
.mode-btn{
  flex:1;padding:5px 0;border:none;cursor:pointer;border-radius:4px;
  font-family:var(--sans);font-size:11px;font-weight:600;
  background:none;color:var(--text3);transition:all .2s;
}
.mode-btn.active{background:var(--cyan);color:#000}

nav{flex:1;padding:6px 10px;overflow-y:auto}
.nav-section-label{
  font-size:10px;font-weight:600;letter-spacing:.1em;
  color:var(--text3);padding:10px 8px 5px;text-transform:uppercase;
}
.nav-item{
  display:flex;align-items:center;gap:10px;padding:9px 10px;
  border-radius:var(--r-sm);color:var(--text2);cursor:pointer;
  transition:all .18s;position:relative;margin-bottom:1px;
  border:1px solid transparent;-webkit-tap-highlight-color:transparent;
}
.nav-item:hover{background:var(--bg3);color:var(--text)}
.nav-item.active{background:var(--cyan-dim);color:var(--cyan);border-color:rgba(0,212,255,.2)}
.nav-item.active::before{
  content:'';position:absolute;left:-10px;top:50%;transform:translateY(-50%);
  width:3px;height:60%;background:var(--cyan);border-radius:0 3px 3px 0;
}
.nav-icon{width:16px;height:16px;flex-shrink:0}
.nav-label{font-size:13px;font-weight:500}
.nav-badge{
  margin-left:auto;font-size:10px;font-weight:700;
  background:var(--red-dim);color:var(--red);
  border-radius:20px;padding:1px 6px;min-width:18px;text-align:center;
}
.nav-badge.green{background:var(--green-dim);color:var(--green)}

.sidebar-footer{
  padding:12px 16px;border-top:1px solid var(--border);
  display:flex;align-items:center;gap:10px;
}
.avatar{
  width:30px;height:30px;border-radius:50%;
  background:linear-gradient(135deg,#0f4c75,var(--cyan));
  display:flex;align-items:center;justify-content:center;
  font-size:11px;font-weight:700;color:white;flex-shrink:0;
}
.user-name{font-size:12px;font-weight:600;color:var(--text)}
.user-role{font-size:11px;color:var(--text3)}
.status-dot{
  width:7px;height:7px;border-radius:50%;background:var(--green);
  box-shadow:0 0 6px var(--green);animation:pulse-dot 2s infinite;margin-left:auto;
}
@keyframes pulse-dot{0%,100%{opacity:1}50%{opacity:.4}}

/* ── MAIN ── */
#main{flex:1;display:flex;flex-direction:column;min-width:0;width:100%}

/* ── TOPBAR ── */
#topbar{
  height:var(--hdr);background:rgba(8,13,18,.9);backdrop-filter:blur(16px);
  border-bottom:1px solid var(--border);
  display:flex;align-items:center;padding:0 14px;gap:10px;
  flex-shrink:0;position:relative;z-index:10;
}

/* hamburger toggle */
#nav-toggle{
  width:36px;height:36px;flex-shrink:0;
  background:var(--surface);border:1px solid var(--border);border-radius:var(--r-sm);
  cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;
  color:var(--text2);transition:all .2s;-webkit-tap-highlight-color:transparent;
  position:relative;
}
#nav-toggle:hover{border-color:var(--cyan);color:var(--cyan);background:var(--cyan-dim)}
.hb-line{
  width:14px;height:1.5px;background:currentColor;border-radius:2px;
  transition:all .25s cubic-bezier(.4,0,.2,1);transform-origin:center;
}
#nav-toggle.open .hb-line:nth-child(1){transform:translateY(5.5px) rotate(45deg)}
#nav-toggle.open .hb-line:nth-child(2){opacity:0;transform:scaleX(0)}
#nav-toggle.open .hb-line:nth-child(3){transform:translateY(-5.5px) rotate(-45deg)}

.topbar-title{
  font-size:14px;font-weight:600;color:var(--text);
  display:flex;align-items:center;gap:7px;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex-shrink:1;min-width:0;
}
.breadcrumb{color:var(--text3);font-size:12px;white-space:nowrap;flex-shrink:0}
@media(max-width:480px){.breadcrumb{display:none}}

.topbar-actions{margin-left:auto;display:flex;align-items:center;gap:8px;flex-shrink:0}

.search-pill{
  display:flex;align-items:center;gap:7px;
  background:var(--surface);border:1px solid var(--border);
  border-radius:20px;padding:6px 12px;cursor:pointer;transition:border-color .2s;
}
.search-pill:hover{border-color:var(--border2)}
.search-pill span{font-size:12px;color:var(--text3)}
.search-pill kbd{font-family:var(--mono);font-size:10px;background:var(--bg3);color:var(--text3);padding:1px 5px;border-radius:3px;border:1px solid var(--border2)}
@media(max-width:600px){
  .search-pill .s-label,.search-pill kbd{display:none}
  .search-pill{padding:6px 8px;border-radius:var(--r-sm)}
}

.icon-btn{
  width:34px;height:34px;flex-shrink:0;
  background:var(--surface);border:1px solid var(--border);border-radius:var(--r-sm);
  cursor:pointer;display:flex;align-items:center;justify-content:center;
  color:var(--text2);transition:all .2s;-webkit-tap-highlight-color:transparent;
}
.icon-btn:hover{border-color:var(--cyan);color:var(--cyan);background:var(--cyan-dim)}
.icon-btn svg{width:15px;height:15px}
.notif-badge{position:relative}
.notif-badge::after{
  content:'3';position:absolute;top:-4px;right:-4px;
  background:var(--red);color:white;font-size:9px;font-weight:700;
  width:14px;height:14px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
}

/* ── WORKSPACE ── */
#workspace{
  flex:1;overflow-y:auto;overflow-x:hidden;
  padding:16px 14px;display:flex;flex-direction:column;gap:14px;
}
@media(min-width:640px){#workspace{padding:20px;gap:16px}}
@media(min-width:1024px){#workspace{padding:24px;gap:20px}}

/* ── CARDS ── */
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);overflow:hidden}
.card-header{
  padding:13px 16px;border-bottom:1px solid var(--border);
  display:flex;align-items:center;gap:10px;flex-wrap:wrap;
}
@media(min-width:640px){.card-header{padding:16px 20px}}
.card-title{font-size:13px;font-weight:600;color:var(--text)}
.card-subtitle{font-size:11px;color:var(--text3);margin-top:2px}
.card-body{padding:14px 16px}
@media(min-width:640px){.card-body{padding:18px 20px}}
.card-actions{margin-left:auto;display:flex;gap:7px;align-items:center;flex-wrap:wrap}

/* ── KPI GRID ── */
.kpi-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
@media(min-width:900px){.kpi-grid{grid-template-columns:repeat(4,1fr);gap:14px}}

.kpi{
  background:var(--surface);border:1px solid var(--border);border-radius:var(--r);
  padding:14px;position:relative;overflow:hidden;
  transition:transform .2s,border-color .2s,box-shadow .2s;cursor:default;
}
@media(min-width:640px){.kpi{padding:18px}}
.kpi::after{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(0,212,255,.03) 0%,transparent 60%);pointer-events:none}
.kpi:hover{transform:translateY(-2px);border-color:var(--border2);box-shadow:0 8px 24px rgba(0,0,0,.3)}
.kpi-icon{width:30px;height:30px;border-radius:8px;display:flex;align-items:center;justify-content:center;margin-bottom:10px}
.kpi-icon svg{width:15px;height:15px}
.kpi-icon.cyan{background:var(--cyan-dim);color:var(--cyan)}
.kpi-icon.green{background:var(--green-dim);color:var(--green)}
.kpi-icon.amber{background:var(--amber-dim);color:var(--amber)}
.kpi-icon.purple{background:var(--purple-dim);color:var(--purple)}
.kpi-label{font-size:10px;font-weight:600;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;margin-bottom:5px}
.kpi-value{font-size:20px;font-weight:700;font-family:var(--mono);color:var(--text);letter-spacing:-.03em;line-height:1}
@media(min-width:640px){.kpi-value{font-size:26px}}
.kpi-delta{display:inline-flex;align-items:center;gap:3px;font-size:11px;font-weight:600;margin-top:7px;padding:2px 6px;border-radius:4px}
.kpi-delta.up{background:var(--green-dim);color:var(--green)}
.kpi-delta.down{background:var(--red-dim);color:var(--red)}
.sparkline{display:flex;align-items:flex-end;gap:2px;height:30px}
.spark-bar{width:4px;border-radius:2px 2px 0 0}
.sparkline.cyan .spark-bar{background:var(--cyan)}
.sparkline.green .spark-bar{background:var(--green)}
.sparkline.amber .spark-bar{background:var(--amber)}
.sparkline.purple .spark-bar{background:var(--purple)}

/* ── GRIDS ── */
.two-col{display:grid;grid-template-columns:1fr;gap:14px}
@media(min-width:700px){.two-col{grid-template-columns:1fr 1fr}}

/* ── TABLE ── */
.tbl-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch}
.tbl{width:100%;border-collapse:collapse;min-width:460px}
.tbl th{padding:9px 12px;text-align:left;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.1em;color:var(--text3);border-bottom:1px solid var(--border);white-space:nowrap}
.tbl td{padding:10px 12px;font-size:13px;border-bottom:1px solid rgba(30,45,61,.6);color:var(--text)}
.tbl tr:hover td{background:rgba(255,255,255,.02)}
.tbl tr:last-child td{border-bottom:none}

/* ── BADGE ── */
.badge{display:inline-flex;align-items:center;gap:5px;padding:3px 8px;border-radius:20px;font-size:10px;font-weight:600;letter-spacing:.05em;white-space:nowrap}
.badge-dot{width:5px;height:5px;border-radius:50%;flex-shrink:0}
.badge.active{background:var(--green-dim);color:var(--green)}.badge.active .badge-dot{background:var(--green);box-shadow:0 0 4px var(--green)}
.badge.paused{background:rgba(77,100,120,.2);color:var(--text3)}.badge.paused .badge-dot{background:var(--text3)}
.badge.pending{background:var(--amber-dim);color:var(--amber)}.badge.pending .badge-dot{background:var(--amber)}
.badge.error{background:var(--red-dim);color:var(--red)}
.badge.running{background:var(--cyan-dim);color:var(--cyan)}.badge.running .badge-dot{background:var(--cyan);animation:pulse-dot 1.5s infinite}

/* ── BUTTONS ── */
.btn{
  display:inline-flex;align-items:center;gap:6px;padding:7px 12px;border-radius:var(--r-sm);
  font-family:var(--sans);font-size:12px;font-weight:600;cursor:pointer;
  border:1px solid var(--border);background:var(--surface2);color:var(--text2);
  transition:all .18s;white-space:nowrap;-webkit-tap-highlight-color:transparent;
}
.btn:hover{border-color:var(--border2);color:var(--text)}
.btn svg{width:13px;height:13px}
.btn-cyan{background:var(--cyan);color:#000;border-color:var(--cyan)}
.btn-cyan:hover{background:#00aacc;border-color:#00aacc;color:#000}
.btn-ghost{background:none;border-color:transparent}
.btn-ghost:hover{background:var(--bg3);border-color:var(--border)}
.btn-danger{background:var(--red-dim);color:var(--red);border-color:rgba(255,77,109,.3)}
.btn-danger:hover{background:var(--red);color:white}
.btn-sm{padding:4px 9px;font-size:11px}
.btn-icon{padding:6px;width:28px;height:28px;justify-content:center}

/* ── AGENTS ── */
.agent-grid{display:grid;grid-template-columns:1fr;gap:14px}
@media(min-width:700px){.agent-grid{grid-template-columns:repeat(2,1fr)}}
.agent-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:16px;display:flex;flex-direction:column;gap:12px;transition:border-color .2s}
.agent-card:hover{border-color:var(--border2)}
.agent-head{display:flex;align-items:center;gap:12px}
.agent-avatar{width:38px;height:38px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.agent-avatar.cyan{background:var(--cyan-dim);color:var(--cyan);border:1px solid rgba(0,212,255,.2)}
.agent-avatar.green{background:var(--green-dim);color:var(--green);border:1px solid rgba(0,229,160,.2)}
.agent-avatar.amber{background:var(--amber-dim);color:var(--amber);border:1px solid rgba(255,181,71,.2)}
.agent-avatar.purple{background:var(--purple-dim);color:var(--purple);border:1px solid rgba(167,139,250,.2)}
.agent-avatar svg{width:18px;height:18px}
.agent-name{font-size:13px;font-weight:600;color:var(--text)}
.agent-desc{font-size:11px;color:var(--text3);margin-top:2px}
.agent-stats{display:flex;gap:12px}
.agent-stat{flex:1}
.agent-stat-label{font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.06em;margin-bottom:3px}
.agent-stat-val{font-size:14px;font-weight:600;font-family:var(--mono);color:var(--text)}
.agent-progress{display:flex;flex-direction:column;gap:5px}
.progress-label{display:flex;justify-content:space-between;font-size:11px;color:var(--text3)}
.progress-bar{height:4px;background:var(--border);border-radius:2px;overflow:hidden}
.progress-fill{height:100%;border-radius:2px;transition:width 1s ease}
.progress-fill.cyan{background:var(--cyan)}.progress-fill.green{background:var(--green)}
.progress-fill.amber{background:var(--amber)}.progress-fill.purple{background:var(--purple)}
.agent-footer{display:flex;gap:8px;align-items:center;margin-top:auto;flex-wrap:wrap}

/* ── TERMINAL ── */
.terminal{background:#030608;border:1px solid var(--border);border-radius:var(--r);overflow:hidden}
.terminal-bar{padding:9px 14px;background:var(--bg2);border-bottom:1px solid var(--border);display:flex;align-items:center;gap:8px}
.t-dot{width:10px;height:10px;border-radius:50%}
.terminal-body{padding:14px;font-family:var(--mono);font-size:11px;line-height:1.9;max-height:320px;overflow-y:auto}
@media(min-width:640px){.terminal-body{font-size:12px}}
.log-line{display:flex;gap:10px;flex-wrap:wrap}
.log-time{color:var(--text3);flex-shrink:0}
.log-level{font-weight:600;flex-shrink:0;width:52px}
.log-level.info{color:var(--cyan)}.log-level.warn{color:var(--amber)}
.log-level.error{color:var(--red)}.log-level.success{color:var(--green)}
.log-msg{color:var(--text2);word-break:break-word;min-width:0}

/* ── TIMELINE ── */
.timeline{display:flex;flex-direction:column}
.timeline-item{display:flex;gap:14px;position:relative}
.timeline-item:not(:last-child){padding-bottom:18px}
.timeline-item:not(:last-child) .t-line{width:1px;background:var(--border);position:absolute;left:15px;top:32px;bottom:0}
.t-icon{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;z-index:1}
.t-icon svg{width:14px;height:14px}
.t-content{flex:1;padding-top:4px;min-width:0}
.t-title{font-size:13px;font-weight:600;color:var(--text)}
.t-meta{font-size:11px;color:var(--text3);margin-top:3px}
.t-detail{margin-top:8px;padding:9px 12px;background:var(--bg2);border:1px solid var(--border);border-radius:var(--r-sm);font-family:var(--mono);font-size:11px;color:var(--text2);word-break:break-word}

/* ── INTEGRATIONS ── */
.integration-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:14px 16px;display:flex;align-items:center;gap:12px;transition:border-color .2s;flex-wrap:wrap}
.integration-card:hover{border-color:var(--border2)}
.int-icon{width:42px;height:42px;border-radius:10px;background:var(--bg2);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
.int-name{font-size:13px;font-weight:600;color:var(--text)}
.int-status{font-size:11px;color:var(--text3);margin-top:2px}
.int-actions{margin-left:auto;display:flex;gap:7px;flex-shrink:0}

/* ── CHAT ── */
.chat-messages{overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:10px;flex:1}
.msg{display:flex;gap:9px;max-width:88%}
.msg.user{flex-direction:row-reverse;align-self:flex-end}
.msg-avatar{width:28px;height:28px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700}
.msg-avatar.ai{background:linear-gradient(135deg,var(--cyan),#0086cc);color:#000}
.msg-avatar.user{background:linear-gradient(135deg,#4c1d95,var(--purple));color:white}
.msg-bubble{padding:9px 13px;border-radius:10px;font-size:13px;line-height:1.6}
.msg.ai .msg-bubble{background:var(--surface2);border:1px solid var(--border);color:var(--text);border-radius:2px 10px 10px 10px}
.msg.user .msg-bubble{background:var(--cyan);color:#000;border-radius:10px 2px 10px 10px;font-weight:500}
.msg-time{font-size:10px;color:var(--text3);margin-top:4px;align-self:flex-end}
.chat-input-area{padding:12px;border-top:1px solid var(--border);display:flex;gap:8px;align-items:flex-end}
.chat-input{flex:1;background:var(--bg2);border:1px solid var(--border);border-radius:var(--r-sm);padding:9px 13px;font-family:var(--sans);font-size:13px;color:var(--text);resize:none;min-height:40px;max-height:100px;outline:none;transition:border-color .2s}
.chat-input:focus{border-color:var(--cyan)}
.chat-input::placeholder{color:var(--text3)}

/* ── MISC ── */
.chart-wrap{position:relative}
.report-range{display:flex;gap:5px;flex-wrap:wrap}
.range-btn{padding:4px 9px;border-radius:4px;font-size:11px;font-weight:600;background:none;border:1px solid var(--border);color:var(--text3);cursor:pointer;transition:all .18s;font-family:var(--sans)}
.range-btn.active{background:var(--cyan-dim);color:var(--cyan);border-color:rgba(0,212,255,.3)}
.field-input{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r-sm);padding:8px 12px;font-family:var(--mono);font-size:12px;color:var(--text);outline:none;width:100%;transition:border-color .2s}
.field-input:focus{border-color:var(--cyan)}
.settings-row{display:flex;align-items:center;gap:12px;margin-bottom:10px;flex-wrap:wrap}
.toggle{position:relative;width:36px;height:20px;background:var(--bg3);border:1px solid var(--border);border-radius:10px;cursor:pointer;transition:all .2s;flex-shrink:0}
.toggle::after{content:'';position:absolute;top:2px;left:2px;width:14px;height:14px;border-radius:50%;background:var(--text3);transition:all .2s}
.toggle.on{background:var(--cyan);border-color:var(--cyan)}
.toggle.on::after{left:18px;background:#000}

/* ── COMMAND PALETTE ── */
#cmd-palette{position:fixed;inset:0;background:rgba(3,6,8,.7);backdrop-filter:blur(8px);z-index:999;display:none;align-items:flex-start;justify-content:center;padding:14vh 16px 0}
#cmd-palette.open{display:flex}
.palette-box{width:100%;max-width:580px;background:var(--surface);border:1px solid var(--border2);border-radius:var(--r);box-shadow:0 32px 80px rgba(0,0,0,.6);overflow:hidden;animation:pal-in .2s cubic-bezier(.16,1,.3,1)}
@keyframes pal-in{from{opacity:0;transform:scale(.97) translateY(-10px)}to{opacity:1;transform:none}}
.palette-input-wrap{display:flex;align-items:center;gap:10px;padding:13px 15px;border-bottom:1px solid var(--border)}
.palette-input-wrap svg{width:16px;height:16px;color:var(--text3);flex-shrink:0}
#cmd-input{flex:1;background:none;border:none;outline:none;font-family:var(--sans);font-size:14px;color:var(--text)}
#cmd-input::placeholder{color:var(--text3)}
.palette-results{padding:7px;max-height:340px;overflow-y:auto}
.cmd-result{display:flex;align-items:center;gap:10px;padding:9px 11px;border-radius:var(--r-sm);cursor:pointer;transition:background .15s}
.cmd-result:hover,.cmd-result.selected{background:var(--cyan-dim)}
.cmd-result:hover .cmd-res-label,.cmd-result.selected .cmd-res-label{color:var(--cyan)}
.cmd-res-icon{width:28px;height:28px;border-radius:6px;background:var(--bg2);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.cmd-res-icon svg{width:14px;height:14px;color:var(--text2)}
.cmd-res-label{font-size:13px;font-weight:500;color:var(--text)}
.cmd-res-tag{margin-left:auto;font-size:10px;color:var(--text3);font-family:var(--mono);background:var(--bg3);padding:2px 6px;border-radius:3px}
.palette-footer{padding:9px 14px;border-top:1px solid var(--border);display:flex;gap:14px}
.palette-hint{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--text3)}
.palette-hint kbd{font-family:var(--mono);font-size:9px;background:var(--bg3);padding:2px 5px;border-radius:3px;border:1px solid var(--border2);color:var(--text2)}

/* ── NOTIFICATIONS ── */
.notif-panel{
  position:fixed;right:12px;top:calc(var(--hdr) + 6px);
  width:min(340px,calc(100vw - 24px));
  background:var(--surface);border:1px solid var(--border2);border-radius:var(--r);
  box-shadow:0 16px 48px rgba(0,0,0,.5);z-index:97;overflow:hidden;display:none;
}
.notif-panel.open{display:block;animation:pal-in .2s cubic-bezier(.16,1,.3,1)}
.notif-header{padding:13px 15px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center}
.notif-title{font-size:13px;font-weight:600;color:var(--text)}
.notif-item{padding:11px 15px;border-bottom:1px solid rgba(30,45,61,.5);display:flex;gap:10px;cursor:pointer;transition:background .15s}
.notif-item:hover{background:var(--bg3)}
.notif-dot{width:7px;height:7px;border-radius:50%;margin-top:4px;flex-shrink:0}
.notif-item-text{font-size:12px;color:var(--text2);line-height:1.5}
.notif-item-meta{font-size:10px;color:var(--text3);margin-top:3px}

@keyframes fade-up{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.fade-up{animation:fade-up .3s ease forwards}
</style>
