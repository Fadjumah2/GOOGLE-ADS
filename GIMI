function kpi(label,value,delta,dir,color,iconPath,sparkData){
  const bars=sparkData?sparkData.split(' ').map(v=>`<div class="spark-bar" style="height:${Math.round((parseFloat(v)/13)*100)}%"></div>`).join(''):'';
  return `<div class="kpi ${color}">
    <div class="kpi-icon ${color}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">${iconPath}</svg></div>
    <div class="kpi-label">${label}</div>
