{
  "version": 2,
  "buildCommand": "npm run build",
  "functions": {
    "server.js": {
      "maxDuration": 60,
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/server.js" }
  ],
  "crons": [
    { "path": "/api/cron/daily", "schedule": "15 23 * * *" }
  ]
}
