{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/server.js"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/server.js"
    },
    {
      "source": "/",
      "destination": "/client/index.html"
    },
    {
      "source": "/auth/:path*",
      "destination": "/server.js"
    },
    {
      "source": "/revoke",
      "destination": "/server.js"
    },
    {
      "source": "/static/:path*",
      "destination": "/client/static/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/client/:path*"
    }
  ]
}