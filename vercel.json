{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/ping", "destination": "/api" },
    { "source": "/privacy", "destination": "/api" },
    { "source": "/terms", "destination": "/api" },
    { "source": "/home", "destination": "/api" },
    { "source": "/dashboard-new", "destination": "/api" }
  ],
  "crons": [
    { "path": "/api/cron/daily", "schedule": "0 6 * * *" }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
